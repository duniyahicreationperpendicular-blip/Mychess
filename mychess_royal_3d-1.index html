<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
<title>MYCHESS — Royal 3D</title>
<style>
:root{--gold:#d9ad59;--bg:#090d16;--panel:#121a29;--muted:#a8b2c4}
*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;overflow:hidden;background:radial-gradient(circle at 50% 0%,#1c2a40,#090d16 65%);color:#f4ead5;font-family:system-ui,Segoe UI,sans-serif}
#app{height:100dvh;display:flex;flex-direction:column;max-width:1100px;margin:auto;padding:10px;gap:8px}
header{display:flex;align-items:center;justify-content:space-between;gap:8px;min-height:42px}
.brand{font-weight:900;letter-spacing:2px;color:#f2d59b;font-size:clamp(16px,3vw,22px)}.brand small{display:block;font-size:9px;letter-spacing:4px;color:#9ca9bb;font-weight:600}
#status{font-size:12px;color:#f4dfb8;text-align:right}
main{display:grid;grid-template-columns:minmax(0,1fr) 230px;gap:10px;flex:1;min-height:0}
#stage{position:relative;min-height:0;border:1px solid #5b4727;border-radius:16px;overflow:hidden;background:linear-gradient(145deg,#172236,#080c14);box-shadow:0 15px 50px #0008}
#game{width:100%;height:100%;display:block;touch-action:none}
#hint{position:absolute;left:12px;bottom:10px;color:#c2c9d4;font-size:11px;background:#08101acc;padding:7px 10px;border-radius:20px;pointer-events:none}
aside{background:linear-gradient(160deg,#172235,#0d1420);border:1px solid #334057;border-radius:16px;padding:12px;display:flex;flex-direction:column;gap:10px;min-height:0}
.turn{font-size:13px;color:#f4d79f;font-weight:700}.sub{font-size:11px;color:var(--muted);line-height:1.5}
.controls{display:grid;grid-template-columns:1fr 1fr;gap:7px}
button{border:1px solid #c49a51;background:linear-gradient(180deg,#26364c,#111a29);color:#f5e5c6;padding:10px 8px;border-radius:10px;font-weight:700;font-size:12px;cursor:pointer;transition:transform .15s,box-shadow .15s,border-color .15s}
button:active{transform:scale(.95);box-shadow:0 0 16px #d9ad5970}button:hover{border-color:#ffe0a1;box-shadow:0 0 12px #d9ad5930}
#moves{overflow:auto;min-height:80px;flex:1;background:#080e18;border:1px solid #26364b;border-radius:10px;padding:8px;font-size:12px;color:#cbd4e1;line-height:1.8}
.moveRow{display:grid;grid-template-columns:26px 1fr 1fr;gap:4px}.moveRow span:first-child{color:#78869b}
footer{font-size:10px;color:#7f8da2;text-align:center}
@media(max-width:650px){#app{padding:7px;gap:6px}main{grid-template-columns:1fr;grid-template-rows:minmax(0,1fr) auto}aside{padding:8px;display:grid;grid-template-columns:1fr 1fr;gap:7px;max-height:145px}.turn,.sub{grid-column:1/-1}.controls{grid-column:1}.controls button{padding:8px 5px}.moves{grid-column:2;max-height:86px;min-height:70px}#moves{max-height:86px;min-height:70px}footer{display:none}}
</style>
</head>
<body>
<div id="app">
<header><div class="brand">MYCHESS <small>ROYAL 3D EDITION</small></div><div id="status">WHITE TO MOVE</div></header>
<main>
<section id="stage"><canvas id="game"></canvas><div id="hint">Tap a piece, then tap a highlighted square · Drag to rotate · Pinch to zoom</div></section>
<aside>
<div class="turn" id="turn">White to move</div>
<div class="sub">Local 1v1 · Standard chess rules · Select a piece to see legal moves.</div>
<div class="controls">
<button id="new">↻ Restart</button><button id="undo">↶ Undo</button>
<button id="flip">⇅ Flip board</button><button id="resetView">◎ Reset view</button>
</div>
<div id="moves"><div style="color:#78869b">Move history appears here.</div></div>
</aside>
</main>
<footer>MYCHESS · Royal wooden board · Powered by Three.js and chess.js</footer>
</div>
<script src="https://cdnjs.cloudflare.com/ajax/libs/chess.js/0.10.3/chess.min.js"></script>
<script type="importmap">
{"imports":{"three":"https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.module.js"}}
</script>
<script type="module">
import * as THREE from 'https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.module.js';
import {OrbitControls} from 'https://cdn.jsdelivr.net/npm/three@0.160.0/examples/jsm/controls/OrbitControls.js';

const canvas=document.querySelector('#game'),stage=document.querySelector('#stage');
const renderer=new THREE.WebGLRenderer({canvas,antialias:true,alpha:true});
renderer.setPixelRatio(Math.min(devicePixelRatio,2));renderer.shadowMap.enabled=true;renderer.shadowMap.type=THREE.PCFSoftShadowMap;renderer.outputColorSpace=THREE.SRGBColorSpace;
const scene=new THREE.Scene();scene.background=new THREE.Color('#101a29');
const camera=new THREE.PerspectiveCamera(34,1,.1,100);camera.position.set(0,8.6,10.5);
const controls=new OrbitControls(camera,renderer.domElement);controls.enableDamping=true;controls.dampingFactor=.07;controls.minDistance=7;controls.maxDistance=17;controls.maxPolarAngle=Math.PI*.47;controls.target.set(0,.2,0);
scene.add(new THREE.HemisphereLight(0xdce8ff,0x49311c,2.1));
const keyLight=new THREE.DirectionalLight(0xffe4b2,3.2);keyLight.position.set(-5,10,7);keyLight.castShadow=true;keyLight.shadow.mapSize.set(2048,2048);keyLight.shadow.camera.left=-8;keyLight.shadow.camera.right=8;keyLight.shadow.camera.top=8;keyLight.shadow.camera.bottom=-8;scene.add(keyLight);
const fill=new THREE.DirectionalLight(0x9abfff,1.2);fill.position.set(6,5,-6);scene.add(fill);
const wood=new THREE.MeshStandardMaterial({color:0x4c2b17,roughness:.34,metalness:.12});
const trim=new THREE.MeshStandardMaterial({color:0xb58a45,metalness:.7,roughness:.24});
const lightSq=new THREE.MeshStandardMaterial({color:0xe4c99b,roughness:.45});
const darkSq=new THREE.MeshStandardMaterial({color:0x68412a,roughness:.4});
const board=new THREE.Group();scene.add(board);
const base=new THREE.Mesh(new THREE.BoxGeometry(8.55,.38,8.55),wood);base.position.y=-.23;base.receiveShadow=true;base.castShadow=true;board.add(base);
const rim=new THREE.Mesh(new THREE.BoxGeometry(8.72,.13,8.72),trim);rim.position.y=-.015;board.add(rim);
const tileGeo=new THREE.BoxGeometry(1,.12,1);
const squares={};const squareMeshes=[];
for(let r=0;r<8;r++)for(let f=0;f<8;f++){
 const name='abcdefgh'[f]+(8-r),m=new THREE.Mesh(tileGeo,(r+f)%2===0?lightSq:darkSq);
 m.position.set(f-3.5,.075,r-3.5);m.receiveShadow=true;m.userData.square=name;board.add(m);squares[name]=m;squareMeshes.push(m);
}
const frame=new THREE.Mesh(new THREE.BoxGeometry(8.95,.16,8.95),trim);frame.position.y=-.43;board.add(frame);
const floor=new THREE.Mesh(new THREE.PlaneGeometry(200,200),new THREE.MeshStandardMaterial({color:0x101827,roughness:.9}));floor.rotation.x=-Math.PI/2;floor.position.y=-.55;floor.receiveShadow=true;scene.add(floor);

const whiteMat=new THREE.MeshStandardMaterial({color:0xf3e6c9,metalness:.28,roughness:.25});
const blackMat=new THREE.MeshStandardMaterial({color:0x202735,metalness:.62,roughness:.24});
const whiteAccent=new THREE.MeshStandardMaterial({color:0xc49a51,metalness:.75,roughness:.22});
const blackAccent=new THREE.MeshStandardMaterial({color:0x9d773c,metalness:.8,roughness:.23});
const pieceGroup=new THREE.Group();scene.add(pieceGroup);
const pieceMeshes=new Map();
function lathe(points,mat,group,segments=24){const g=new THREE.LatheGeometry(points.map(p=>new THREE.Vector2(p[0],p[1])),segments);const m=new THREE.Mesh(g,mat);m.castShadow=true;m.receiveShadow=true;group.add(m);return m}
function sphere(rad,x,y,z,mat,group,scaleY=1){const m=new THREE.Mesh(new THREE.SphereGeometry(rad,20,14),mat);m.position.set(x,y,z);m.scale.y=scaleY;m.castShadow=true;group.add(m);return m}
function box(w,h,d,x,y,z,mat,group){const m=new THREE.Mesh(new THREE.BoxGeometry(w,h,d),mat);m.position.set(x,y,z);m.castShadow=true;group.add(m);return m}
function makePiece(type,color){
 const g=new THREE.Group(),mat=color==='w'?whiteMat:blackMat,acc=color==='w'?whiteAccent:blackAccent;
 const basePts=[[.0,.03],[.32,.03],[.36,.09],[.34,.16],[.26,.21],[.22,.27],[.18,.34],[.16,.42]];
 lathe(basePts,mat,g);
 lathe([[.16,.39],[.22,.43],[.23,.48],[.18,.52]],acc,g);
 if(type==='p'){
  lathe([[.13,.48],[.16,.57],[.12,.68],[.08,.75]],mat,g);sphere(.13,0,.82,0,mat,g);
 }else if(type==='r'){
  lathe([[.16,.48],[.22,.55],[.22,.72],[.25,.76],[.25,.83]],mat,g);
  for(let i=0;i<4;i++){let a=i*Math.PI/2;box(.13,.15,.13,Math.sin(a)*.17,.88,Math.cos(a)*.17,acc,g)}
 }else if(type==='n'){
  lathe([[.16,.48],[.2,.56],[.15,.65],[.12,.72]],mat,g);
  const neck=new THREE.Mesh(new THREE.ConeGeometry(.19,.5,5),mat);neck.position.set(0,.88,-.02);neck.rotation.z=-.28;neck.castShadow=true;g.add(neck);
  sphere(.14,.08,1.1,-.04,mat,g,.75);sphere(.035,.19,1.13,.04,acc,g);
 }else if(type==='b'){
  lathe([[.16,.48],[.2,.58],[.13,.72],[.1,.9]],mat,g);
  sphere(.13,0,1.02,0,acc,g,1.3);sphere(.045,0,1.12,0,mat,g);
 }else if(type==='q'){
  lathe([[.16,.48],[.23,.58],[.17,.72],[.13,.9],[.2,.98]],mat,g);
  for(let i=0;i<5;i++){let a=i*Math.PI*2/5;sphere(.075,Math.cos(a)*.18,1.04,Math.sin(a)*.18,acc,g)}
  sphere(.12,0,1.02,0,acc,g);
 }else if(type==='k'){
  lathe([[.16,.48],[.24,.58],[.17,.74],[.14,.96],[.2,1.02]],mat,g);
  box(.09,.42,.09,0,1.27,0,acc,g);box(.32,.09,.09,0,1.29,0,acc,g);sphere(.07,0,1.51,0,acc,g);
 }
 g.userData={type,color};return g;
}
let game=new Chess(),selected=null,legalTargets=[],flipped=false;
const highlights=new THREE.Group();scene.add(highlights);
function clearHighlights(){while(highlights.children.length)highlights.remove(highlights.children[0])}
function highlight(sq,color,ring=false){const f='abcdefgh'.indexOf(sq[0]),r=8-Number(sq[1]);const geo=ring?new THREE.RingGeometry(.28,.36,32):new THREE.PlaneGeometry(.9,.9);const mat=new THREE.MeshBasicMaterial({color,transparent:true,opacity:ring?.85:.32,side:THREE.DoubleSide,depthWrite:false});const m=new THREE.Mesh(geo,mat);m.rotation.x=-Math.PI/2;m.position.set(f-3.5,.145,r-3.5);highlights.add(m)}
function renderPieces(){
 while(pieceGroup.children.length)pieceGroup.remove(pieceGroup.children[0]);pieceMeshes.clear();
 const b=game.board();
 for(let r=0;r<8;r++)for(let f=0;f<8;f++){const p=b[r][f];if(!p)continue;const sq='abcdefgh'[f]+(8-r),g=makePiece(p.type,p.color);g.position.set(f-3.5,.14,r-3.5);pieceGroup.add(g);pieceMeshes.set(sq,g)}
}
function updateUI(){
 const over=game.game_over();let s=game.turn()==='w'?'White to move':'Black to move';
 if(game.in_checkmate())s='Checkmate — '+(game.turn()==='w'?'Black':'White')+' wins!';
 else if(game.in_stalemate())s='Draw — stalemate';
 else if(game.in_draw())s='Draw game';
 else if(game.in_check())s+=' · Check';
 document.querySelector('#turn').textContent=s;document.querySelector('#status').textContent=s.toUpperCase();
 const hist=game.history();let out='';for(let i=0;i<hist.length;i+=2){out+=`<div class="moveRow"><span>${i/2+1}.</span><span>${hist[i]||''}</span><span>${hist[i+1]||''}</span></div>`}
 document.querySelector('#moves').innerHTML=out||'<div style="color:#78869b">Move history appears here.</div>';
 document.querySelector('#undo').disabled=hist.length===0;
}
function selectSquare(sq){
 if(game.game_over())return;
 const p=game.get(sq);
 if(selected){const candidate=game.moves({square:selected,verbose:true}).find(m=>m.to===sq);
  if(candidate){let promotion='q';if(candidate.flags.includes('p')){const answer=prompt('Promote pawn to: q (Queen), r (Rook), b (Bishop), n (Knight)','q');promotion=(answer||'q').toLowerCase();if(!'qrbn'.includes(promotion))promotion='q'}
   game.move({from:selected,to:sq,promotion});selected=null;legalTargets=[];clearHighlights();renderPieces();updateUI();return;
  }
 }
 if(p&&p.color===game.turn()){
  selected=sq;legalTargets=game.moves({square:sq,verbose:true}).map(m=>m.to);clearHighlights();highlight(sq,0xffd34e,true);legalTargets.forEach(t=>highlight(t,0x47d69a,pieceMeshes.has(t)));return;
 }
 selected=null;legalTargets=[];clearHighlights();
}
const raycaster=new THREE.Raycaster(),pointer=new THREE.Vector2();
renderer.domElement.addEventListener('pointerup',e=>{
 const rect=canvas.getBoundingClientRect();pointer.x=((e.clientX-rect.left)/rect.width)*2-1;pointer.y=-((e.clientY-rect.top)/rect.height)*2+1;
 raycaster.setFromCamera(pointer,camera);const hits=raycaster.intersectObjects(squareMeshes,false);
 if(hits.length)selectSquare(hits[0].object.userData.square);
});
document.querySelector('#new').onclick=()=>{game.reset();selected=null;clearHighlights();renderPieces();updateUI()};
document.querySelector('#undo').onclick=()=>{game.undo();selected=null;clearHighlights();renderPieces();updateUI()};
document.querySelector('#flip').onclick=()=>{flipped=!flipped;camera.position.set(0,8.6,flipped?-10.5:10.5);camera.lookAt(0,0,0);controls.target.set(0,.2,0);controls.update()};
document.querySelector('#resetView').onclick=()=>{flipped=false;camera.position.set(0,8.6,10.5);controls.target.set(0,.2,0);controls.update()};
function resize(){const w=stage.clientWidth,h=stage.clientHeight;renderer.setSize(w,h,false);camera.aspect=w/h;camera.updateProjectionMatrix()}
new ResizeObserver(resize).observe(stage);resize();renderPieces();updateUI();
function animate(){requestAnimationFrame(animate);controls.update();renderer.render(scene,camera)}animate();
</script>
</body>
</html>